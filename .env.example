# Optional overrides. Liner defaults to ~/Music/Local Files and stores runtime
# state under the operating system's per-user application-data directory.
LINER_LIBRARY_ROOT=
LINER_PORT=8764

# Optional OpenAI-compatible metadata assistant.
LINER_AI_BASE_URL=https://api.deepseek.com/v1
LINER_AI_MODEL=deepseek-chat
LINER_AI_API_KEY=

# Optional MeTube sidecar integration. Credentials remain local and untracked.
LINER_METUBE_SIDECAR_URL=
LINER_METUBE_CF_CLIENT_ID=
LINER_METUBE_CF_CLIENT_SECRET=
LINER_METUBE_API_KEY=
